# AI Crash Log Analyzer (/api/analyze-log)
# Works with ANY ChatGPT-compatible (OpenAI-compatible) endpoint:
# OpenRouter, LM Studio, Ollama (openai compat), Together, DeepSeek, vLLM, etc.
# All three variables are required. Values are read server-side only
# (process.env) and are never sent to the browser.
#
# Examples:
#   OpenRouter:  AI_BASE_URL=https://openrouter.ai/api/v1
#   LM Studio:   AI_BASE_URL=http://localhost:1234/v1
#   Ollama:      AI_BASE_URL=http://localhost:11434/v1
#   Together:    AI_BASE_URL=https://api.together.xyz/v1
AI_BASE_URL=
AI_API_KEY=
# The exact model id your provider serves, e.g.:
#   openai/gpt-4o-mini (OpenRouter), qwen2.5:7b (Ollama), deepseek-chat (DeepSeek)
AI_MODEL=
